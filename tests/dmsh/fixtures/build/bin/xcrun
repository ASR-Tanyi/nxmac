#!/usr/bin/env python3
# A stand-in for Apple's xcrun where there is no Xcode: the Metal tools are metal and metallib beside this file (they compile nothing: see them).
import os, sys
HERE = os.path.dirname(os.path.abspath(__file__))
a = sys.argv[1:]
sdk = 'macosx'
if a[:1] == ['-sdk']: sdk = a[1]; a = a[2:]
if a[:1] == ['-f']: print(os.path.join(HERE, a[1])); sys.exit(0)
if a == ['--show-sdk-path']: print(f'/fake/Xcode.app/SDKs/{sdk}.sdk'); sys.exit(0)
if a == ['--show-sdk-version']: print('26.6'); sys.exit(0)
if a == ['--show-sdk-build-version']: print('25G100'); sys.exit(0)
if a and a[0] in ('metal', 'metallib'): os.execv(os.path.join(HERE, a[0]), [a[0]] + a[1:])
sys.exit(f'fake xcrun: {" ".join(sys.argv[1:])}?')
